# Optional public override used to validate the token audience and issuer.
# Leave blank when the root script can reuse EXPO_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=

# Required and server-only. Restrict it to the Books API and your backend host.
# Keep billing disabled; do not continue if the console asks you to enable it.
GOOGLE_BOOKS_API_KEY=your-restricted-google-books-key

HOST=127.0.0.1
PORT=8787

# Comma-separated Expo web origins. Native apps do not normally send Origin.
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# In-process safeguards; they do not require a database or paid service.
GOOGLE_BOOKS_TIMEOUT_MS=8000
RECOMMENDATION_CACHE_TTL_MS=900000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
